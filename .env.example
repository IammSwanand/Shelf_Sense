# Copy this file to .env and adjust values as needed.
# docker-compose.yml reads these automatically.

# ── Detector ─────────────────────────────────────────────────────────────────
DET_CONF_THRESHOLD=0.25      # YOLO confidence threshold
DET_IOU_THRESHOLD=0.45       # YOLO NMS IoU threshold
DET_IMG_SIZE=640             # Inference resolution (must match training)

# ── Grouping ──────────────────────────────────────────────────────────────────
DBSCAN_EPS=0.28              # Cosine-distance neighbourhood radius for DBSCAN
DBSCAN_MIN_SAMPLES=1         # Min samples per cluster (1 = every point seeds a cluster)

# ── Orchestrator ──────────────────────────────────────────────────────────────
DOWNSTREAM_TIMEOUT=60        # Seconds before upstream call times out

# ── Rate-card filter ──────────────────────────────────────────────────────────
RATECARD_MAX_ASPECT=2.5          # Stage A: width/height above this = "flat" candidate
RATECARD_MAX_HEIGHT_FRAC=0.06    # Stage A: box height / image height below this is "short"
RATECARD_MIN_COLOR_FRACTION=0.60 # Stage B: tag-colour pixel fraction to flag
RATECARD_ROW_HEIGHT_RATIO=0.50   # Stage C: fraction of row median height to flag
RATECARD_DEBUG=false             # Set to true to attach filter_reason to API output
