# ShelfSense Configuration Environment Variables
# Copy this file to .env and adjust values as needed.
# docker-compose.yml reads these automatically.

# ── PyTorch Build & Acceleration ─────────────────────────────────────────────
# Default is lightweight CPU build (~1.5 GB total image).
# For NVIDIA CUDA GPU acceleration, set to CUDA wheel index (cu126 preferred):
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cu126
# Other valid CUDA versions: cu124, cu121, cu118
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# ── Hardware Device Runtime ──────────────────────────────────────────────────
DEVICE=auto                  # 'auto' (detects GPU if available, else CPU), 'cpu', 'cuda', '0'

# ── Detector ─────────────────────────────────────────────────────────────────
# WEIGHTS_DOWNLOAD_URL=https://huggingface.co/chistopat/sku110k-yolo11-object-detector/resolve/main/weights/sku110k-yolo11-s640.pt
DET_CONF_THRESHOLD=0.65      # YOLO confidence threshold
DET_IOU_THRESHOLD=0.70       # YOLO NMS IoU threshold
DET_IMG_SIZE=640             # Inference resolution (must match training)

# ── Grouping ──────────────────────────────────────────────────────────────────
CLUSTER_THRESHOLD=auto       # 'auto' (image-adaptive self-calibrating) or fixed float (e.g. 0.35)
DINO_WEIGHT=0.70             # Weight for DINOv2 visual embedding similarity (0.0 to 1.0)
COLOR_WEIGHT=0.30            # Weight for 3D HSV color histogram similarity (0.0 to 1.0)

# ── Orchestrator ──────────────────────────────────────────────────────────────
DOWNSTREAM_TIMEOUT=60        # Seconds before upstream call times out

# ── Rate-card filter ──────────────────────────────────────────────────────────
RATECARD_MAX_ASPECT=2.5          # Stage A: width/height above this = "flat" candidate
RATECARD_MAX_HEIGHT_FRAC=0.06    # Stage A: box height / image height below this is "short"
RATECARD_MIN_COLOR_FRACTION=0.60 # Stage B: tag-colour pixel fraction to flag
RATECARD_ROW_HEIGHT_RATIO=0.50   # Stage C: fraction of row median height to flag
RATECARD_DEBUG=false             # Set to true to attach filter_reason to API output
